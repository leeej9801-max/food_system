APP_ENV=development
API_PREFIX=/api/v1
# 로컬 PostgreSQL (db/docker-compose.yml 기준 예시 - 실제 비밀번호는 로컬 .env에서만 설정)
DATABASE_URL=postgresql+psycopg://app_user:change_me_local_only@localhost:5432/restaurant_ax
# http로 다른 기기에서 접속해 손님 화면을 볼 때만 false (기본 true)
# GUEST_COOKIE_SECURE=false
APP_TIMEZONE=Asia/Seoul
CORS_ALLOWED_ORIGINS=http://localhost:5173
POS_MODE=csv
POS_CLIENT_ID=
POS_CLIENT_SECRET=
POS_WEBHOOK_SECRET=

# 직원 카카오 로그인. 실제 값은 .env에만 설정한다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8001/api/v1/auth/kakao/callback
STAFF_FRONTEND_URL=http://localhost:5175
# 선택: 32바이트 이상 독립 키. 미설정 시 client secret에서 용도 분리 유도.
STAFF_AUTH_SIGNING_KEY=

# 기상청 API허브 (U-56). 키는 커밋하지 않는다
KMA_APIHUB_KEY=
KMA_STATION_ID=433
KMA_GRID_NX=56
KMA_GRID_NY=125
