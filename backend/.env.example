APP_ENV=development
API_PREFIX=/api/v1
# 로컬 PostgreSQL (db/docker-compose.yml 기준 예시 - 실제 비밀번호는 로컬 .env에서만 설정)
DATABASE_URL=postgresql+psycopg://app_user:change_me_local_only@localhost:5432/restaurant_ax
# Docker 미실행 시 로컬 파일 SQLite 임시 실행 예시 (PROVISIONAL P-07):
# DATABASE_URL=sqlite:///./local_dev.db
APP_TIMEZONE=Asia/Seoul
CORS_ALLOWED_ORIGINS=http://localhost:5173
POS_MODE=csv
POS_CLIENT_ID=
POS_CLIENT_SECRET=
POS_WEBHOOK_SECRET=
