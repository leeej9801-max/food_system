APP_ENV=development
API_PREFIX=/api/v1
# 로컬 PostgreSQL (db/docker-compose.yml 기준 예시 - 실제 비밀번호는 로컬 .env에서만 설정)
DATABASE_URL=postgresql+psycopg://app_user:change_me_local_only@localhost:5432/restaurant_ax
# http로 다른 기기에서 접속해 손님 화면을 볼 때만 false (기본 true)
# GUEST_COOKIE_SECURE=false
APP_TIMEZONE=Asia/Seoul
CORS_ALLOWED_ORIGINS=http://localhost:5173
POS_MODE=csv
POS_CLIENT_ID=
POS_CLIENT_SECRET=
POS_WEBHOOK_SECRET=
